---
import '../styles/kahf.css';
import '../styles/product.css';
import 'virtual:kahf/site.css'; // the site's own touches (kahf({ styles }) in its astro.config.mjs)
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { path, other, type Product, type Lang, type Page } from '../lib/product';

interface Props {
  p: Product;
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Extra class on the root, e.g. a product's own surface treatment. */
  rootClass?: string;
  /** The 404 page: header links must point at the home page. */
  notFound?: boolean;
}

const { p, lang, page, title, description, noindex, jsonLd, rootClass, notFound } = Astro.props;
const ar = lang === 'ar';
const abs = (x: string) => new URL(x, p.url).href;
const here = path(p, lang, page);
const enPath = path(p, 'en', page);
const arPath = path(p, 'ar', page);
const rootPath = path(p, p.rootLang, page);
const fontPreload = ar ? ['IBMPlexSansArabic-Regular', 'IBMPlexSansArabic-Bold'] : ['IBMPlexSans-Regular', 'IBMPlexSans-SemiBold'];
const skip = ar ? 'انتقل إلى المحتوى' : 'Skip to content';
---
<!doctype html>
<html lang={lang} dir={ar ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <noscript><style>@media (max-width: 759px) { .ks-mobile-nav[hidden] { display: flex !important; } } .ks-menu-btn, [data-theme-toggle], [data-copy], [data-run] { display: none !important; } [data-run-output][hidden] { display: block !important; }</style></noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={abs(here)} />}
    {!noindex && <link rel="alternate" hreflang="en" href={abs(enPath)} />}
    {!noindex && <link rel="alternate" hreflang="ar" href={abs(arPath)} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(rootPath)} />}
    {fontPreload.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0d0b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={p.name[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(here)} />
    <meta property="og:image" content={abs(`/og/${lang}.png`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ar ? 'ar_SA' : 'en_US'} />
    <meta property="og:locale:alternate" content={ar ? 'en_US' : 'ar_SA'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class={['ks-root', p.scope, `pp-${p.id}`, rootClass].filter(Boolean).join(' ')}>
      <a class="ks-skip" href="#main">{skip}</a>
      <Header p={p} lang={lang} page={page} notFound={notFound} />
      <slot />
      <Footer p={p} lang={lang} />
      <p class="ks-sr" aria-live="polite" data-announce></p>
    </div>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
